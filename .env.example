# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. This file is committed, so never put a real secret here.

# Neon connection string, POOLED endpoint (the one with "-pooler" in the host).
# Neon dashboard -> your project -> Connection string -> Pooled connection.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Anthropic key. Server-side only. Never prefix with NEXT_PUBLIC_.
# console.anthropic.com -> Settings -> API keys. Needs billing credit to work.
ANTHROPIC_API_KEY="sk-ant-..."
