{
  "name": "company-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:corpus && next build",
    "start": "next start",
    "build:corpus": "node scripts/build-corpus.mjs",
