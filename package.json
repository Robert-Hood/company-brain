    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.5.4",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
